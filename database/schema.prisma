generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum CmsArticleStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ContentAudienceType {
  COMPANY
  DEPARTMENT
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique
  username        String?              @unique
  passwordHash    String               @map("password_hash")
  status          UserStatus           @default(ACTIVE)
  profile         UserProfile?
  employee        Employee?
  roles           UserRole[]
  sessions        UserSession[]
  resetTokens     PasswordResetToken[]
  auditLogs       AuditLog[]
  authoredArticles CmsArticle[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  phone       String?
  avatarUrl   String?  @map("avatar_url")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_profiles")
}

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  name        String
  employees   Employee[]
  cmsArticles CmsArticle[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  @@map("departments")
}

model Position {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique
  name      String
  employees Employee[]
  @@map("positions")
}

model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @map("user_id") @db.Uuid
  employeeCode String         @unique @map("employee_code")
  departmentId String?        @map("department_id") @db.Uuid
  positionId   String?        @map("position_id") @db.Uuid
  managerId    String?        @map("manager_id") @db.Uuid
  status       EmployeeStatus @default(ACTIVE)
  joinedAt     DateTime?      @map("joined_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position     Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager      Employee?      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      Employee[]     @relation("EmployeeManager")
  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  key         String     @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id       String           @id @default(uuid()) @db.Uuid
  key      String           @unique
  name     String
  roles    RolePermission[]
  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model CmsArticle {
  id           String              @id @default(uuid()) @db.Uuid
  title        String              @db.VarChar(180)
  slug         String              @unique @db.VarChar(200)
  summary      String              @db.VarChar(500)
  body         String              @db.Text
  status       CmsArticleStatus    @default(DRAFT)
  audienceType ContentAudienceType @default(COMPANY) @map("audience_type")
  departmentId String?             @map("department_id") @db.Uuid
  authorId     String              @map("author_id") @db.Uuid
  publishedAt  DateTime?           @map("published_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  author       User                @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categories   CmsArticleCategory[]
  tags         CmsArticleTag[]

  @@index([status, publishedAt])
  @@index([audienceType, departmentId, status])
  @@map("cms_articles")
}

model CmsCategory {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @unique @db.VarChar(100)
  slug      String               @unique @db.VarChar(120)
  createdAt DateTime             @default(now()) @map("created_at")
  articles  CmsArticleCategory[]
  @@map("cms_categories")
}

model CmsTag {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique @db.VarChar(80)
  slug      String           @unique @db.VarChar(100)
  createdAt DateTime         @default(now()) @map("created_at")
  articles  CmsArticleTag[]
  @@map("cms_tags")
}

model CmsArticleCategory {
  articleId  String      @map("article_id") @db.Uuid
  categoryId String      @map("category_id") @db.Uuid
  article    CmsArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   CmsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([articleId, categoryId])
  @@index([categoryId, articleId])
  @@map("cms_article_categories")
}

model CmsArticleTag {
  articleId String     @map("article_id") @db.Uuid
  tagId     String     @map("tag_id") @db.Uuid
  article   CmsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       CmsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([articleId, tagId])
  @@index([tagId, articleId])
  @@map("cms_article_tags")
}
