generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum CmsArticleStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ContentAudienceType {
  COMPANY
  DEPARTMENT
}

enum DocumentClassification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  CHANGES_REQUESTED
}

enum ApprovalActionType {
  APPROVE
  REJECT
  REQUEST_CHANGES
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                     String               @id @default(uuid()) @db.Uuid
  email                  String               @unique
  username               String?              @unique
  passwordHash           String               @map("password_hash")
  status                 UserStatus           @default(ACTIVE)
  profile                UserProfile?
  employee               Employee?
  roles                  UserRole[]
  sessions               UserSession[]
  resetTokens            PasswordResetToken[]
  auditLogs              AuditLog[]
  authoredArticles       CmsArticle[]
  documents              Document[]
  documentVersions       DocumentVersion[]
  projectsOwned          Project[]
  projectMembers         ProjectMember[]
  assignedTasks          TaskAssignee[]
  createdTasks           Task[]
  approvalRequests       ApprovalRequest[]
  approvalActions        ApprovalAction[]
  approvalReviewRequests ApprovalRequest[]    @relation("ApprovalReviewer")
  workflowDefinitions    WorkflowDefinition[] @relation("WorkflowCreator")
  workflowSteps          WorkflowStep[]       @relation("WorkflowStepReviewer")
  notifications          Notification[]
  leaveRequests          LeaveRequest[]
  leaveDecisions         LeaveRequest[]       @relation("LeaveDecider")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

model UserProfile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  displayName String  @map("display_name")
  phone       String?
  avatarUrl   String? @map("avatar_url")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  employees   Employee[]
  cmsArticles CmsArticle[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("departments")
}

model Position {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique
  name      String
  employees Employee[]

  @@map("positions")
}

model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @map("user_id") @db.Uuid
  employeeCode String         @unique @map("employee_code")
  departmentId String?        @map("department_id") @db.Uuid
  positionId   String?        @map("position_id") @db.Uuid
  managerId    String?        @map("manager_id") @db.Uuid
  status       EmployeeStatus @default(ACTIVE)
  joinedAt     DateTime?      @map("joined_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position     Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager       Employee?      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports       Employee[]     @relation("EmployeeManager")
  leaveRequests LeaveRequest[]

  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model CmsArticle {
  id           String               @id @default(uuid()) @db.Uuid
  title        String               @db.VarChar(180)
  slug         String               @unique @db.VarChar(200)
  summary      String               @db.VarChar(500)
  body         String               @db.Text
  status       CmsArticleStatus     @default(DRAFT)
  audienceType ContentAudienceType  @default(COMPANY) @map("audience_type")
  departmentId String?              @map("department_id") @db.Uuid
  authorId     String               @map("author_id") @db.Uuid
  publishedAt  DateTime?            @map("published_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categories   CmsArticleCategory[]
  tags         CmsArticleTag[]

  @@index([status, publishedAt])
  @@index([audienceType, departmentId, status])
  @@map("cms_articles")
}

model CmsCategory {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @unique @db.VarChar(100)
  slug      String               @unique @db.VarChar(120)
  createdAt DateTime             @default(now()) @map("created_at")
  articles  CmsArticleCategory[]

  @@map("cms_categories")
}

model CmsTag {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique @db.VarChar(80)
  slug      String          @unique @db.VarChar(100)
  createdAt DateTime        @default(now()) @map("created_at")
  articles  CmsArticleTag[]

  @@map("cms_tags")
}

model CmsArticleCategory {
  articleId  String      @map("article_id") @db.Uuid
  categoryId String      @map("category_id") @db.Uuid
  article    CmsArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   CmsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId, articleId])
  @@map("cms_article_categories")
}

model CmsArticleTag {
  articleId String     @map("article_id") @db.Uuid
  tagId     String     @map("tag_id") @db.Uuid
  article   CmsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       CmsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId, articleId])
  @@map("cms_article_tags")
}

model Document {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String                 @db.VarChar(255)
  description    String?                @db.VarChar(1000)
  classification DocumentClassification @default(INTERNAL)
  folderPath     String                 @default("/") @map("folder_path") @db.VarChar(1000)
  mimeType       String                 @map("mime_type") @db.VarChar(150)
  sizeBytes      BigInt                 @map("size_bytes")
  storageKey     String                 @unique @map("storage_key")
  ownerId        String                 @map("owner_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions       DocumentVersion[]

  @@index([ownerId, createdAt])
  @@index([folderPath, createdAt])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  version    Int
  sizeBytes  BigInt   @map("size_bytes")
  mimeType   String   @map("mime_type") @db.VarChar(150)
  storageKey String   @unique @map("storage_key")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator    User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([documentId, version])
  @@map("document_versions")
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(180)
  description String?         @db.Text
  status      ProjectStatus   @default(PLANNING)
  ownerId     String          @map("owner_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  tasks       Task[]

  @@index([ownerId, status])
  @@map("projects")
}

model ProjectMember {
  projectId String  @map("project_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  title       String         @db.VarChar(240)
  description String?        @db.Text
  status      TaskStatus     @default(TODO)
  priority    TaskPriority   @default(MEDIUM)
  dueDate     DateTime?      @map("due_date")
  creatorId   String         @map("creator_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  assignees   TaskAssignee[]

  @@index([projectId, status, dueDate])
  @@map("tasks")
}

model TaskAssignee {
  taskId String @map("task_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignees")
}

model WorkflowDefinition {
  id          String         @id @default(uuid()) @db.Uuid
  key         String         @unique @db.VarChar(100)
  name        String         @db.VarChar(180)
  description String?        @db.VarChar(1000)
  active      Boolean        @default(true)
  creatorId   String         @map("creator_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  creator     User           @relation("WorkflowCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  steps       WorkflowStep[]
  approvals   ApprovalRequest[] @relation("ApprovalWorkflow")

  @@map("workflow_definitions")
}

model WorkflowStep {
  id         String             @id @default(uuid()) @db.Uuid
  workflowId String             @map("workflow_id") @db.Uuid
  order      Int
  name       String             @db.VarChar(180)
  reviewerId String             @map("reviewer_id") @db.Uuid
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  reviewer   User               @relation("WorkflowStepReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  actions    ApprovalAction[]

  @@unique([workflowId, order])
  @@index([reviewerId])
  @@map("workflow_steps")
}

model ApprovalRequest {
  id          String              @id @default(uuid()) @db.Uuid
  type        String              @db.VarChar(100)
  title       String              @db.VarChar(240)
  payload     Json
  status      ApprovalStatus      @default(DRAFT)
  requesterId String              @map("requester_id") @db.Uuid
  reviewerId  String?             @map("reviewer_id") @db.Uuid
  workflowId  String?             @map("workflow_id") @db.Uuid
  currentStep Int?                @map("current_step")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  requester   User                @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  reviewer    User?               @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  workflow    WorkflowDefinition? @relation("ApprovalWorkflow", fields: [workflowId], references: [id], onDelete: SetNull)
  actions     ApprovalAction[]

  @@index([requesterId, status, createdAt])
  @@index([workflowId, currentStep])
  @@map("approval_requests")
}

model ApprovalAction {
  id        String          @id @default(uuid()) @db.Uuid
  requestId String          @map("request_id") @db.Uuid
  actorId   String          @map("actor_id") @db.Uuid
  stepId   String?          @map("step_id") @db.Uuid
  type      ApprovalActionType
  comment   String?         @db.VarChar(1000)
  createdAt DateTime        @default(now()) @map("created_at")
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  step      WorkflowStep?   @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("approval_actions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(180)
  message   String    @db.VarChar(1000)
  link      String?   @db.VarChar(500)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model LeaveRequest {
  id          String       @id @default(uuid()) @db.Uuid
  employeeId  String       @map("employee_id") @db.Uuid
  requesterId String       @map("requester_id") @db.Uuid
  deciderId   String?      @map("decider_id") @db.Uuid
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime     @map("end_date") @db.Date
  reason      String       @db.VarChar(1000)
  status      LeaveStatus  @default(PENDING)
  decisionNote String?     @map("decision_note") @db.VarChar(1000)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requester   User         @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  decider     User?        @relation("LeaveDecider", fields: [deciderId], references: [id], onDelete: SetNull)

  @@index([employeeId, status, startDate])
  @@index([requesterId, createdAt])
  @@map("leave_requests")
}
