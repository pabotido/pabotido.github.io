{
  "name": "enterprise-corporate-portal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.5",
  "engines": { "node": ">=20.0.0" },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.46.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @portal/api --filter @portal/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema database/schema.prisma",
    "db:seed": "tsx database/seed.ts"
  }
}
