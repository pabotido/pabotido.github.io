NODE_ENV=development
APP_NAME=Enterprise Corporate Portal
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_PREFIX=/api/v1
TIMEZONE=Asia/Ho_Chi_Minh

DATABASE_URL=postgresql://portal:portal_dev_password@localhost:5432/enterprise_portal
REDIS_URL=redis://localhost:6379

AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
AUTH_SECRET=replace-with-long-random-local-secret

STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=portal-files
S3_ACCESS_KEY=local-access
S3_SECRET_KEY=local-secret

EMAIL_SERVER_HOST=smtppro.zoho.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=your-mailbox@example.com
EMAIL_SERVER_PASSWORD=your-zoho-app-password
EMAIL_FROM=your-mailbox@example.com

LOG_LEVEL=debug
