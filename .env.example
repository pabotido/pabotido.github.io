NODE_ENV=development
APP_NAME=Enterprise Corporate Portal
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=/api/v1
TIMEZONE=Asia/Ho_Chi_Minh

DATABASE_URL=postgresql://portal:portal_dev_password@localhost:5432/enterprise_portal
REDIS_URL=redis://localhost:6379

AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
AUTH_SECRET=replace-with-long-random-local-secret

STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=portal-files
S3_ACCESS_KEY=local-access
S3_SECRET_KEY=local-secret

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

LOG_LEVEL=debug
